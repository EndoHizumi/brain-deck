# brain-deck 用カーネルの設定の差分（linux-brain の brain_defconfig に重ねる）
#
# 使い方は docs/kernel-build.md を参照。
# 前提となる USB_GADGET と USB_CONFIGFS は、brain_defconfig で有効になっている。
# （merge_config.sh はコメント行の設定も読むので、コメントには「CONFIG_ＸＸ=値」の形を書かない）

# HID 関数（f_hid）。configfs で functions/hid.usb0 を作れるようにする。
# これで /dev/hidg0 ができ、lefthand はここにキーボードのレポートを書いて PC に送る。
# 選ぶと USB_F_HID も有効になる。
CONFIG_USB_CONFIGFS_F_HID=y

# CDC ACM 関数（f_acm）。configfs で functions/acm.usb0 と acm.usb1 を作れるようにする。
# これで /dev/ttyGS0（シリアルコンソール用）と /dev/ttyGS1（設定 GUI 用）ができる。
# 選ぶと USB_F_ACM と USB_U_SERIAL も有効になる。
CONFIG_USB_CONFIGFS_ACM=y
